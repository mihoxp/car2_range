[Unit]
Description=Car 2 too-close auto stop (relays /car2/cmd_vel_raw to /car2/cmd_vel)
After=micro-ros-agent.service

[Service]
Type=simple
User=ros2
Environment=ROS_DOMAIN_ID=20
Environment=ROS_LOCALHOST_ONLY=0
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && exec /home/ros2/rust_ws/car2_range/target/release/car2_safety'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
